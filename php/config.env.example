# Настройки сервера заявок JAQAIYM.
# Скопируйте этот файл под именем config.env (в той же папке jaqaiym-private) и заполните.
# config.env лежит вне корня сайта, в git не попадает, значения вставляет владелец сайта сам.
# Строки с # — комментарии. Пробелов вокруг = и кавычек не нужно.

# Пароль для входа в /admin. Длинная случайная строка, не короче 16 символов (лучше 32).
# Получить: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Двухфакторный вход (настоятельно рекомендуется): ключ для приложения-аутентификатора (TOTP).
# Ключ и строку для ADMIN_PATH выдаёт скрипт на вашем компьютере: python3 tools/make_2fa.py
# Неверное значение отключает админку, а не ослабляет защиту.
# ADMIN_TOTP_SECRET=

# Непубличный адрес админки вместо угадываемого /admin: вид /admin/ЗНАЧЕНИЕ (8-64 символа: буквы, цифры, - и _).
# ADMIN_PATH=

# Адрес сайта (в ссылках в Telegram и для вебхука).
PUBLIC_BASE_URL=https://jaqaiym.kz

# Бот: токен выдаёт @BotFather. Не публикуйте его и не пересылайте.
TELEGRAM_BOT_TOKEN=

# Секретный код подписки: кто отправит боту /join КОД, начнёт получать заявки.
# Получить: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
TELEGRAM_JOIN_CODE=

# Необязательно: общий чат команды (у группы id отрицательный, вида -100...).
# TELEGRAM_CHAT_ID=

# Необязательно: лимиты и сроки (значения по умолчанию)
# UPLOAD_QUOTA_MB=500
# MIN_FREE_MB=150
# UNSENT_FILE_DAYS=7
# ORPHAN_HOURS=24
# RETENTION_DAYS=365
# CORS_ORIGINS=
