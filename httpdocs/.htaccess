# JAQAIYM: правила для Apache на хостинге (Plesk). Лежит в корне сайта (httpdocs).
# Код приложения, база и файлы заявок лежат ВНЕ корня сайта (папка jaqaiym-private) и отсюда недоступны.

AddDefaultCharset UTF-8
Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On
# у сайта один адрес: www ведёт на основной домен (иначе поисковик видит дубли всех страниц); http на https перенаправляет сам Plesk
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# приём заявок, админку и вебхук Telegram обрабатывает единственный PHP-файл api/index.php
RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^(api|admin)(/|$) /api/index.php [L]
</IfModule>

# На сайте нет других PHP-файлов: любые посторонние не исполняются и не отдаются
<FilesMatch "\.(php|phtml|phar|inc)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
# скрытые файлы (.env, .git и т. п.) не отдаются никогда
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
# принуждает браузер ходить только по https (по http заголовок игнорируется); включайте, когда https уже работает
Header always set Strict-Transport-Security "max-age=31536000"
# настоящий CSP-заголовок (в дополнение к <meta> на страницах, который точечно разрешает свои встроенные скрипты по хешу).
# Здесь только то, что не зависит от конкретной страницы: frame-ancestors (meta его не умеет — усиливает X-Frame-Options)
# и остальные директивы без script-src/default-src, чтобы не спорить с хешами скриптов из <meta>.
Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'"
# бренд хостинга в заголовке ответа — лишняя информация об используемом стеке
Header always unset X-Powered-By
# страницы и скрипты проверяются при каждом заходе (дёшево, 304), чтобы после обновления сайта не оставалась старая версия
<FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
